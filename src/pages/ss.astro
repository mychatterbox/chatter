---
import Html from "components/layout/html.astro";
import Nav from "components/layout/navbar.astro";
---

<Html
  title="실시간 화면 공유 | mychatterbox"
  description="실시간 화면 공유 방송을 시청합니다."
  robots="noindex"
>
  <Nav />

  <main class="screen-share-page">
    <header class="screen-share-header">
      <h1>실시간 화면 공유 0.6</h1>
    </header>

    <section class="player" aria-label="실시간 화면 공유 플레이어">
      <div class="video-frame" id="videoFrame">
        <video id="streamVideo" autoplay playsinline muted controls></video>
        <div class="player-status" id="playerStatus" role="status" aria-live="polite">
          방송 연결을 확인하고 있습니다.
        </div>
      </div>
    </section>

    <details class="diagnostics" open>
      <summary>수신 상태 HUD</summary>
      <dl class="diagnostics-grid">
        <!-- <div><dt>시청자 수</dt><dd>서버 측 확인 필요</dd></div> -->
        <div><dt>해상도</dt><dd data-stat="resolution">-</dd></div>
        <div><dt>영상 비트레이트</dt><dd data-stat="bitrate-video">-</dd></div>
        <div><dt>수신 비트레이트</dt><dd data-stat="bitrate-total">-</dd></div>
        <div><dt>영상 코덱</dt><dd data-stat="codec-video">-</dd></div>
        <div><dt>수신 FPS</dt><dd data-stat="fps">-</dd></div>
      </dl>
      <!-- <p class="diagnostics-note">
        수신 통계는 이 브라우저 연결 기준입니다. 시청자 수는 MediaMTX 서버 지표를 별도로 연결해야 표시할 수 있습니다.
      </p> -->
    </details>

    <p class="player-fallback">
      플레이어 연결에 문제가 있으면 아래 링크를 이용해 주세요
      <br>
      <a href="https://media.chatter.kr/wow" target="_blank" rel="noopener noreferrer">
        MediaMTX 플레이어 직접 열기
      </a>
    </p>
  </main>
</Html>

<script>
  const WHEP_URL = "https://media.chatter.kr/wow/whep";
  const RETRY_DELAY_MS = 3000;

  let video = document.querySelector<HTMLVideoElement>("#streamVideo");
  let playerStatus = document.querySelector<HTMLElement>("#playerStatus");
  let diagnosticsPanel = document.querySelector<HTMLElement>(".diagnostics");
  let boundVideo: HTMLVideoElement | null = null;

  if (!video || !playerStatus) {
    throw new Error("Screen-share player elements are missing.");
  }

  let peerConnection: RTCPeerConnection | null = null;
  let whepResourceUrl: string | null = null;
  let retryTimer: ReturnType<typeof setTimeout> | null = null;
  let statsTimer: ReturnType<typeof setInterval> | null = null;
  let connectionGeneration = 0;
  let remoteStream: MediaStream | null = null;
  let previousBytes = new Map<string, { bytes: number; timestamp: number }>();

  function setStatus(message: string, live = false) {
    playerStatus.textContent = message;
    playerStatus.classList.toggle("is-hidden", live);
  }

  function closePeerConnection() {
    if (statsTimer) clearInterval(statsTimer);
    statsTimer = null;
    previousBytes.clear();
    if (whepResourceUrl) {
      const resourceUrl = whepResourceUrl;
      whepResourceUrl = null;
      void fetch(resourceUrl, { method: "DELETE" }).then((response) => {
        if (!response.ok) {
          console.warn(`[ScreenShare] WHEP session cleanup failed (${response.status}).`);
        }
      }).catch((error) => {
        console.warn("[ScreenShare] WHEP session cleanup failed:", error);
      });
    }

    if (peerConnection) {
      peerConnection.ontrack = null;
      peerConnection.onconnectionstatechange = null;
      peerConnection.close();
      peerConnection = null;
    }
    video.srcObject = null;
    remoteStream = null;
    renderStatsUnavailable();
  }

  function waitForIceGathering(pc: RTCPeerConnection, generation: number) {
    if (pc.iceGatheringState === "complete") return Promise.resolve();

    return new Promise<void>((resolve, reject) => {
      const timeout = setTimeout(() => {
        pc.removeEventListener("icegatheringstatechange", onStateChange);
        reject(new Error("ICE gathering timed out."));
      }, 10000);

      function onStateChange() {
        if (generation !== connectionGeneration) {
          clearTimeout(timeout);
          pc.removeEventListener("icegatheringstatechange", onStateChange);
          reject(new Error("Connection attempt was superseded."));
          return;
        }
        if (pc.iceGatheringState === "complete") {
          clearTimeout(timeout);
          pc.removeEventListener("icegatheringstatechange", onStateChange);
          resolve();
        }
      }

      pc.addEventListener("icegatheringstatechange", onStateChange);
    });
  }

  function scheduleReconnect(message: string) {
    if (retryTimer) return;
    setStatus(message);
    retryTimer = setTimeout(() => {
      retryTimer = null;
      void connectToStream();
    }, RETRY_DELAY_MS);
  }

  function statNumber(stat: RTCStats, key: string): number | undefined {
    const value = (stat as RTCStats & Record<string, unknown>)[key];
    return typeof value === "number" && Number.isFinite(value) ? value : undefined;
  }

  function statString(stat: RTCStats, key: string): string | undefined {
    const value = (stat as RTCStats & Record<string, unknown>)[key];
    return typeof value === "string" ? value : undefined;
  }

  function setStat(name: string, value: string) {
    diagnosticsPanel?.querySelector<HTMLElement>(`[data-stat="${name}"]`)?.replaceChildren(document.createTextNode(value));
  }

  function formatBitrate(bitsPerSecond: number | undefined) {
    if (bitsPerSecond === undefined || !Number.isFinite(bitsPerSecond)) return "-";
    return `${(bitsPerSecond / 1_000_000).toFixed(2)} Mbps`;
  }

  function bitrateFor(stat: RTCStats, timestamp: number) {
    const bytes = statNumber(stat, "bytesReceived");
    if (bytes === undefined) return undefined;
    const previous = previousBytes.get(stat.id);
    previousBytes.set(stat.id, { bytes, timestamp });
    if (!previous || timestamp <= previous.timestamp || bytes < previous.bytes) return undefined;
    return ((bytes - previous.bytes) * 8 * 1000) / (timestamp - previous.timestamp);
  }

  function renderStatsUnavailable() {
    for (const name of [
      "resolution", "bitrate-total", "bitrate-video", "codec-video", "fps",
    ]) {
      setStat(name, "-");
    }
  }

  async function updateStats(pc: RTCPeerConnection, generation: number) {
    const report = await pc.getStats();
    if (generation !== connectionGeneration || pc !== peerConnection) return;

    const stats = [...report.values()];
    const codecStats = new Map(stats.filter((stat) => stat.type === "codec").map((stat) => [stat.id, stat]));
    const mimeTypeFor = (stat: RTCStats) => {
      const codec = codecStats.get(statString(stat, "codecId") ?? "");
      return codec ? statString(codec, "mimeType") : undefined;
    };
    const inbound = stats.filter((stat) => stat.type === "inbound-rtp");
    const videoStats = inbound.filter((stat) =>
      (statString(stat, "kind") ?? statString(stat, "mediaType")) === "video" &&
      !(mimeTypeFor(stat) ?? "").toLowerCase().endsWith("/rtx"),
    );
    const audioStats = inbound.filter((stat) =>
      (statString(stat, "kind") ?? statString(stat, "mediaType")) === "audio",
    );

    const now = performance.now();
    const videoBitrates = videoStats.map((stat) => bitrateFor(stat, now));
    const audioBitrates = audioStats.map((stat) => bitrateFor(stat, now));
    const total = [...videoBitrates, ...audioBitrates];
    const sumAvailable = (values: Array<number | undefined>) =>
      values.some((value) => value !== undefined)
        ? values.reduce<number>((sum, value) => sum + (value ?? 0), 0)
        : undefined;
    const videoStat = videoStats[0];
    const width = videoStat ? statNumber(videoStat, "frameWidth") : undefined;
    const height = videoStat ? statNumber(videoStat, "frameHeight") : undefined;
    setStat(
      "resolution",
      width && height
        ? `${width} × ${height}${video.videoWidth && video.videoHeight && (video.videoWidth !== width || video.videoHeight !== height) ? ` (재생 ${video.videoWidth} × ${video.videoHeight})` : ""}`
        : video.videoWidth && video.videoHeight
          ? `${video.videoWidth} × ${video.videoHeight}`
          : "-",
    );
    setStat("bitrate-total", formatBitrate(sumAvailable(total)));
    setStat("bitrate-video", formatBitrate(sumAvailable(videoBitrates)));
    const formatCodec = (stat: RTCStats | undefined) => {
      if (!stat) return "-";
      const mimeType = mimeTypeFor(stat);
      const codecName = mimeType?.split("/").at(-1);
      return codecName ? codecName.toUpperCase() : "-";
    };
    setStat("codec-video", formatCodec(videoStat));
    setStat(
      "fps",
      videoStat && statNumber(videoStat, "framesPerSecond") !== undefined
        ? `${statNumber(videoStat, "framesPerSecond")!.toFixed(1)} fps`
        : "-",
    );

  }

  async function connectToStream() {
    const generation = ++connectionGeneration;
    closePeerConnection();
    setStatus("방송 연결을 확인하고 있습니다.");

    const pc = new RTCPeerConnection();
    peerConnection = pc;
    statsTimer = setInterval(() => {
      void updateStats(pc, generation).catch((error) => {
        console.warn("[ScreenShare] Could not update WebRTC statistics:", error);
      });
    }, 1000);
    remoteStream = new MediaStream();
    pc.addTransceiver("video", { direction: "recvonly" });
    pc.addTransceiver("audio", { direction: "recvonly" });

    pc.ontrack = (event) => {
      if (generation !== connectionGeneration) return;
      if (!remoteStream?.getTracks().some((track) => track.id === event.track.id)) {
        remoteStream?.addTrack(event.track);
      }
      if (video.srcObject !== remoteStream) {
        video.srcObject = remoteStream;
      }
      if (video.paused) {
        void video.play().catch(() => {
          setStatus("재생하려면 영상이나 재생 버튼을 눌러 주세요.");
        });
      }
    };

    pc.onconnectionstatechange = () => {
      if (generation !== connectionGeneration) return;
      if (pc.connectionState === "connected") {
        setStatus("방송 중", true);
      } else if (pc.connectionState === "failed" || pc.connectionState === "closed") {
        closePeerConnection();
        scheduleReconnect("연결이 끊겼습니다. 다시 연결하고 있습니다.");
      }
    };

    try {
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      await waitForIceGathering(pc, generation);
      if (generation !== connectionGeneration || !pc.localDescription?.sdp) return;

      const response = await fetch(WHEP_URL, {
        method: "POST",
        headers: { "Content-Type": "application/sdp" },
        body: pc.localDescription.sdp,
      });
      if (!response.ok) {
        throw new Error(`WHEP request failed (${response.status}).`);
      }

      const location = response.headers.get("Location");
      if (location) {
        whepResourceUrl = new URL(location, WHEP_URL).toString();
      }
      const answer = await response.text();
      if (generation !== connectionGeneration) return;
      await pc.setRemoteDescription({ type: "answer", sdp: answer });
    } catch (error) {
      if (generation !== connectionGeneration) return;
      console.warn("[ScreenShare] Unable to connect to the live stream:", error);
      closePeerConnection();
      scheduleReconnect("방송 대기 중입니다. 방송이 시작되면 자동으로 연결합니다.");
    }
  }

  function bindPageElements() {
    const nextVideo = document.querySelector<HTMLVideoElement>("#streamVideo");
    const nextPlayerStatus = document.querySelector<HTMLElement>("#playerStatus");
    const nextDiagnosticsPanel = document.querySelector<HTMLElement>(".diagnostics");

    if (!nextVideo || !nextPlayerStatus || !nextDiagnosticsPanel) {
      return false;
    }

    const isNewPage = boundVideo !== nextVideo;
    video = nextVideo;
    playerStatus = nextPlayerStatus;
    diagnosticsPanel = nextDiagnosticsPanel;
    if (!isNewPage) return true;

    boundVideo = video;

    video.addEventListener("playing", () => {
      if (peerConnection?.connectionState === "connected") {
        setStatus("방송 중", true);
      }
    });

    return true;
  }

  document.addEventListener("astro:before-swap", () => {
    connectionGeneration++;
    if (retryTimer) clearTimeout(retryTimer);
    retryTimer = null;
    closePeerConnection();
  });

  const startPlayer = () => {
    if (!bindPageElements()) return;
    if (!peerConnection && !retryTimer) void connectToStream();
  };
  document.addEventListener("astro:page-load", startPlayer);
  startPlayer();
</script>

<style>
  .screen-share-page {
    width: min(100% - 1em, 240em);
    margin: 0 auto;
    padding: 1em 0;
  }

  .screen-share-header {
    margin-bottom: 1.5rem;
  }

  .screen-share-eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .video-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    /* aspect-ratio: 16 / 9; */
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    /* background: #111; */
  }

  .video-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .player-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    color: #fff;
    text-align: center;
    /* background: rgb(0 0 0 / 62%); */
  }

  .player-status.is-hidden {
    display: none;
  }

  .player-fallback {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .player-fallback a {
    color: var(--color-text-primary);
  }

  .diagnostics {
    margin-top: 1.5rem;
    padding: 1rem;
    /* border: 1px solid var(--color-border); */
    border-radius: 0.5rem;
    background: var(--color-background-secondary, transparent);
  }

  .diagnostics summary {
    cursor: pointer;
    font-weight: 700;
  }

  .diagnostics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10em, 1fr));
    /* gap: 0.75rem; */
    margin: 1rem 0 0;
  }

  .diagnostics-grid > div {
    min-width: 0;
    padding: 0.75rem;
    /* border: 1px solid var(--color-border); */
    /* border-radius: 0.375rem; */
  }

  .diagnostics-grid dt {
    /* color: var(--color-text-muted); */
    /* font-size: 0.8rem; */
  }

  .diagnostics-grid dd {
    overflow-wrap: anywhere;
    margin: 0.25rem 0 0;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .diagnostics-note {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

</style>
