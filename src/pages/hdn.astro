---
import Html from "components/layout/html.astro";
import Nav from "components/layout/navbar.astro";
---

<Html
  title="핫딜 모음 | mychatterbox"
  description="크롤링된 핫딜 정보를 모아 보여주는 페이지입니다."
>
  <Nav />

  <main class="main-container">
    <article class="article-container">
      <div class="hdn-page">
        <div class="header-row">
          <div>
            <h1>뭐 살거 없나 v0.8</h1>
          </div>
          <div class="header-actions">
            <button class="icon-btn" id="settingsBtn" title="설정">⚙</button>
          </div>
        </div>

        <div class="card" id="settingsCard">
          <div id="settingsContent">불러오는 중...</div>
        </div>

        <div class="card">
          <div class="search-row">
            <input
              id="searchInput"
              type="text"
              placeholder="제목으로 검색..."
            />
            <button id="searchBtn">검색</button>
            <button class="btn-secondary" id="searchResetBtn">초기화</button>
          </div>
        </div>

        <div class="card" id="filterCard">
          <div class="filter-row" id="sourceFilterRow">
            <button class="filter-all-btn" id="filterAllBtn">전체</button>
          </div>
          <div class="keyword-filter-row" id="keywordFilterChips"></div>
          <div class="keyword-filter-add">
            <input
              id="keywordFilterInput"
              type="text"
              placeholder="화면에 표시할 키워드 추가 (알림과는 별개)"
            />
            <button id="keywordFilterAddBtn">추가</button>
          </div>
        </div>

        <div class="last-updated-row" id="statusRow">
          <button
            class="filter-toggle-btn"
            id="filterToggleBtn"
            style="display:none;">🔍 필터 설정</button
          >
          <span id="deal-status" class="status-message"
            >핫딜 정보를 불러오는 중입니다...</span
          >
          <span id="deal-meta" class="meta-pill">마지막 업데이트: -</span>
        </div>

        <div class="card">
          <div id="dealsList">
            <div id="deal-list" class="deal-list"></div>
          </div>
          <div class="more-btn-row" id="moreBtnRow" style="display:none;">
            <button class="more-btn" id="moreBtn">더보기</button>
          </div>
        </div>
      </div>
    </article>
  </main>
</Html>

<script>
  const apiBase =
    import.meta.env.PUBLIC_HDN_API_URL ||
    "https://hd-notification.chatterer.workers.dev";
  const isDev =
    window.location.hostname === "127.0.0.1" ||
    window.location.hostname === "localhost";
  const apiPrefix = isDev ? "/api/hdn" : apiBase + "/api";

  function escapeHtml(text) {
    return String(text ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  function formatDate(sqliteDatetime) {
    if (!sqliteDatetime) return "-";
    const date = new Date(sqliteDatetime.replace(" ", "T") + "Z");
    if (Number.isNaN(date.getTime())) return sqliteDatetime;
    const kst = new Date(date.getTime() + 9 * 60 * 60_000);
    const y = kst.getUTCFullYear();
    const m = String(kst.getUTCMonth() + 1).padStart(2, "0");
    const d = String(kst.getUTCDate()).padStart(2, "0");
    const hh = String(kst.getUTCHours()).padStart(2, "0");
    const mm = String(kst.getUTCMinutes()).padStart(2, "0");
    return `${y}-${m}-${d}  ${hh}:${mm}`;
  }

  function formatNowKST() {
    const kst = new Date(Date.now() + 9 * 60 * 60_000);
    const y = kst.getUTCFullYear();
    const m = String(kst.getUTCMonth() + 1).padStart(2, "0");
    const d = String(kst.getUTCDate()).padStart(2, "0");
    const hh = String(kst.getUTCHours()).padStart(2, "0");
    const mm = String(kst.getUTCMinutes()).padStart(2, "0");
    return `${y}-${m}-${d} ${hh}:${mm}`;
  }

  function updateLastUpdatedLabel() {
    const el = document.getElementById("deal-meta");
    if (el) el.textContent = `마지막 업데이트: ${formatNowKST()}`;
  }

  function extractTitleAndPrice(title, keyword) {
    let cleanTitle = escapeHtml(title);
    const priceMatches = [];

    cleanTitle = cleanTitle.replace(/\(([^()]*)\)/g, (whole, inner) => {
      const isPriceLike =
        /\d[\d,.]*\s*(원|만)|\$\s*\d[\d,.]*|[￦₩]\s*\d[\d,.]*|^\s*\d[\d,.]*\s*(\/|~|$)/.test(
          inner,
        );
      if (isPriceLike) {
        priceMatches.push(whole);
        return "";
      }
      return whole;
    });

    cleanTitle = cleanTitle.replace(/\d[\d,.]*\s*원(?:\s*\/[^\s<]*)?/g, (m) => {
      priceMatches.push(m);
      return "";
    });

    cleanTitle = cleanTitle.replace(/[￦₩]\s*\d[\d,.]*/g, (m) => {
      priceMatches.push(m);
      return "";
    });

    cleanTitle = cleanTitle
      .replace(/[,\-·/]\s*$/, "")
      .replace(/\s{2,}/g, " ")
      .trim();

    if (keyword) {
      const keywordList = keyword
        .split(",")
        .map((k) => k.trim())
        .filter(Boolean);
      for (const kw of keywordList) {
        const escapedKeyword = escapeHtml(kw).replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&",
        );
        cleanTitle = cleanTitle.replace(
          new RegExp(escapedKeyword, "gi"),
          (match) => `<mark class="hl-keyword">${match}</mark>`,
        );
      }
    }

    function cleanPriceText(raw) {
      let t = raw.trim();
      t = t.replace(/^\(/, "").replace(/\)$/, "").trim();
      t = t.replace(/\/\s*(무료배송|무료|무배|착불|유료)[\s\S]*$/, "").trim();
      t = t.replace(/^(무료배송|무료|무배)$/, "").trim();
      t = t
        .replace(/[￦₩]\s*/g, "")
        .replace(/\s*\(KRW\)\s*$/i, "")
        .trim();
      if (/^[\d,]+(\.\d+)?$/.test(t)) t = `${t}원`;
      return t;
    }

    // 같은 가격이 괄호형/￦형 등 중복으로 잡힌 경우, 정리 후 메인 금액 기준으로 중복 제거
    // 예: "14,630원/3,000원"과 "14,630원"이 함께 있으면 더 상세한 정보(배송비 포함 등)를 유지
    const cleanedPrices = priceMatches.map(cleanPriceText).filter(Boolean);
    const priceMap = new Map();
    for (const p of cleanedPrices) {
      const numMatch = p.match(/[\d,]+(?:\.\d+)?/);
      const key = numMatch ? numMatch[0].replace(/,/g, "") : p;
      const existing = priceMap.get(key);
      if (!existing || p.length > existing.length) {
        priceMap.set(key, p);
      }
    }

    const priceHtml = Array.from(priceMap.values())
      .map((p) => `<span class="hl-price">${p}</span>`)
      .join(" ");

    return { titleHtml: cleanTitle, priceHtml };
  }

  const SOURCE_LABELS = {
    ppomppu: "뽐뿌",
    quasarzone: "퀘이사존",
    arca: "아카라이브",
    ruliweb: "루리웹",
    eomisae: "어미새",
  };
  function sourceLabel(source) {
    return SOURCE_LABELS[source] || source;
  }

  const FAVICON_URLS = {
    ppomppu: "/icons/ppomppu.png",
    quasarzone:
      "https://www.google.com/s2/favicons?domain=quasarzone.com&sz=32",
    arca: "https://www.google.com/s2/favicons?domain=arca.live&sz=32",
    ruliweb: "https://www.google.com/s2/favicons?domain=ruliweb.com&sz=32",
    eomisae: "https://www.google.com/s2/favicons?domain=eomisae.co.kr&sz=32",
  };

  function statusBadgeClass(status) {
    if (!status) return null;
    if (status.includes("종료")) return "ended";
    return null;
  }

  let currentUser = null;
  let currentProfile = null;
  let allDeals = [];
  let nextCursor = null;
  let activeSources = new Set(Object.keys(SOURCE_LABELS));
  let keywordFilters = [];
  let currentSearchQuery = "";
  let pagesLoaded = 1;
  let filterPanelOpen = false;

  function passesKeywordFilter(title) {
    if (keywordFilters.length === 0) return true;
    const normalized = title.toLowerCase();
    return keywordFilters.some((k) => normalized.includes(k.toLowerCase()));
  }

  function renderDealsList() {
    const list = document.getElementById("deal-list");
    const statusMsg = document.getElementById("deal-status");
    const filtered = allDeals.filter(
      (d) => activeSources.has(d.source) && passesKeywordFilter(d.title),
    );

    if (filtered.length === 0) {
      statusMsg.textContent = "표시할 핫딜이 없습니다.";
      statusMsg.style.display = "inline-flex";
      list.innerHTML = "";
    } else {
      statusMsg.style.display = "none";
      const html = filtered
        .map((d) => {
          const badgeClass = statusBadgeClass(d.status);
          const statusHtml = badgeClass
            ? `<span class="status-badge ${badgeClass}">${escapeHtml(d.status)}</span> · `
            : "";
          const favicon = FAVICON_URLS[d.source] || "";
          // keywordFilters 기반으로 하이라이트 표시
          const { titleHtml, priceHtml } = extractTitleAndPrice(
            d.title,
            keywordFilters.join(","),
          );

          return `
          <div class="deal-item">
            <img class="deal-favicon" src="${favicon}" alt="" title="${sourceLabel(d.source)}" />
            <div class="deal-content">
              <a class="deal-title" href="${d.url}" target="_blank" rel="noopener">${titleHtml}</a>
              <div class="deal-meta">
                <span class="meta-left">${statusHtml}${priceHtml}</span>
                <span class="meta-right">${formatDate(d.posted_at)}</span>
              </div>
            </div>
          </div>
        `;
        })
        .join("");
      list.innerHTML = html;
    }

    const moreRow = document.getElementById("moreBtnRow");
    if (moreRow) {
      moreRow.style.display = nextCursor ? "block" : "none";
    }
  }

  async function fetchDealsPage({ reset }) {
    const params = new URLSearchParams();
    if (currentSearchQuery) params.set("q", currentSearchQuery);
    if (!reset && nextCursor) {
      params.set("beforePostedAt", nextCursor.beforePostedAt);
      params.set("beforeId", nextCursor.beforeId);
    }
    params.set("limit", "20");

    const res = await fetch(`${apiPrefix}/deals?${params.toString()}`);
    if (!res.ok) throw new Error("API 오류");
    const data = await res.json();

    if (reset) {
      allDeals = data.deals || [];
      pagesLoaded = 1;
    } else {
      allDeals = allDeals.concat(data.deals || []);
      pagesLoaded += 1;
    }
    nextCursor = data.nextCursor && data.hasMore ? data.nextCursor : null;

    renderDealsList();
    updateLastUpdatedLabel();
  }

  function setupMoreButton() {
    const btn = document.getElementById("moreBtn");
    if (!btn) return;
    btn.onclick = async () => {
      btn.disabled = true;
      btn.textContent = "불러오는 중...";
      try {
        await fetchDealsPage({ reset: false });
      } catch (e) {
        console.error(e);
      }
      btn.disabled = false;
      btn.textContent = "더보기";
    };
  }

  function setupSearch() {
    const input = document.getElementById("searchInput");
    const btn = document.getElementById("searchBtn");
    const resetBtn = document.getElementById("searchResetBtn");
    if (!input || !btn || !resetBtn) return;

    const run = async () => {
      currentSearchQuery = input.value.trim();
      nextCursor = null;
      await fetchDealsPage({ reset: true });
    };
    btn.onclick = run;
    input.onkeydown = (e) => {
      if (e.key === "Enter") run();
    };
    resetBtn.onclick = async () => {
      input.value = "";
      currentSearchQuery = "";
      nextCursor = null;
      await fetchDealsPage({ reset: true });
    };
  }

  function renderFilterCard() {
    const filterCard = document.getElementById("filterCard");
    const toggleBtn = document.getElementById("filterToggleBtn");
    if (!filterCard || !toggleBtn) return;

    const isApproved = !!(currentUser && currentUser.approved);

    toggleBtn.style.display = isApproved ? "inline-flex" : "none";
    if (filterPanelOpen) toggleBtn.classList.add("active");
    else toggleBtn.classList.remove("active");

    if (isApproved && filterPanelOpen) filterCard.classList.add("open");
    else filterCard.classList.remove("open");

    if (!isApproved) return;

    const row = document.getElementById("sourceFilterRow");
    row.querySelectorAll("label").forEach((el) => el.remove());
    const checkboxesHtml = Object.entries(SOURCE_LABELS)
      .map(
        ([key, label]) => `
      <label>
        <input type="checkbox" data-source="${key}" ${activeSources.has(key) ? "checked" : ""} />
        <img class="filter-favicon" src="${FAVICON_URLS[key]}" alt="" />
        ${label}
      </label>
    `,
      )
      .join("");
    row.insertAdjacentHTML("beforeend", checkboxesHtml);

    row.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
      cb.onchange = () => {
        const source = cb.getAttribute("data-source");
        if (cb.checked) activeSources.add(source);
        else activeSources.delete(source);
        renderDealsList();
        saveFilterPrefs();
      };
    });

    document.getElementById("filterAllBtn").onclick = () => {
      const allChecked =
        activeSources.size === Object.keys(SOURCE_LABELS).length;
      row.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.checked = !allChecked;
      });
      activeSources = new Set(allChecked ? [] : Object.keys(SOURCE_LABELS));
      renderDealsList();
      saveFilterPrefs();
    };

    renderKeywordFilterChips();
    document.getElementById("keywordFilterAddBtn").onclick = addKeywordFilter;
    document.getElementById("keywordFilterInput").onkeydown = (e) => {
      if (e.key === "Enter") addKeywordFilter();
    };
  }

  function setupFilterToggle() {
    const btn = document.getElementById("filterToggleBtn");
    if (!btn) return;
    btn.onclick = () => {
      filterPanelOpen = !filterPanelOpen;
      renderFilterCard();
    };
  }

  function renderKeywordFilterChips() {
    const wrap = document.getElementById("keywordFilterChips");
    if (!wrap) return;
    wrap.innerHTML = keywordFilters
      .map(
        (k, i) => `
      <span class="keyword-chip">${escapeHtml(k)} <button data-idx="${i}">✕</button></span>
    `,
      )
      .join("");
    wrap.querySelectorAll("button").forEach((btn) => {
      btn.onclick = () => {
        keywordFilters.splice(Number(btn.getAttribute("data-idx")), 1);
        renderKeywordFilterChips();
        renderDealsList();
        saveFilterPrefs();
      };
    });
  }

  function addKeywordFilter() {
    const input = document.getElementById("keywordFilterInput");
    const value = input.value.trim();
    if (!value || keywordFilters.includes(value)) return;
    keywordFilters.push(value);
    input.value = "";
    renderKeywordFilterChips();
    renderDealsList();
    saveFilterPrefs();
  }

  async function saveFilterPrefs() {
    if (!currentUser || !currentUser.approved) return;
    await fetch(`${apiPrefix}/me`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        siteFilter: Array.from(activeSources),
        keywordFilter: keywordFilters,
      }),
    }).catch(() => {});
  }

  async function loadCurrentUser() {
    try {
      const data = await fetch(`${apiPrefix}/auth/me`).then((r) => r.json());
      currentUser = data.user;
    } catch (e) {
      currentUser = null;
    }
  }

  function renderSettingsCard() {
    const el = document.getElementById("settingsContent");
    if (!el) return;

    if (!currentUser) {
      el.innerHTML = renderAuthTabsHtml();
      setupAuthTabs();
      return;
    }
    if (!currentUser.approved) {
      el.innerHTML = `
        <div class="pending-box">
          <h3>가입 승인 대기 중</h3>
          <p>「${escapeHtml(currentUser.nickname)}」님의 가입 요청이 아직 승인되지 않았습니다.<br>
          승인 전에는 키워드 등록과 알림을 받을 수 없고, 전체 핫딜 조회만 가능합니다.<br>
          관리자 승인 후 다시 접속해주세요.</p>
          <div class="btn-row"><button class="btn-secondary" id="pendingLogoutBtn">로그아웃</button></div>
        </div>
      `;
      document.getElementById("pendingLogoutBtn").onclick = doLogout;
      return;
    }

    el.innerHTML = "불러오는 중...";
    Promise.all([
      fetch(`${apiPrefix}/me`).then((r) => r.json()),
      fetch(`${apiPrefix}/me/keywords`).then((r) => r.json()),
      fetch(`${apiPrefix}/auth/sessions`).then((r) => r.json()),
    ])
      .then(([profileData, keywordsData, sessionsData]) => {
        currentProfile = profileData.user;
        renderApprovedSettingsHtml(
          currentProfile,
          keywordsData.keywords,
          sessionsData.sessions,
        );
      })
      .catch((e) => {
        el.innerHTML = "설정 정보를 불러오지 못했습니다.";
      });
  }

  function renderAuthTabsHtml() {
    return `
      <div class="tab-row">
        <button class="tab-btn active" data-tab="login">로그인</button>
        <button class="tab-btn" data-tab="register">회원가입</button>
      </div>
      <div id="authTabContent"></div>
    `;
  }

  function renderLoginFormHtml() {
    return `
      <div class="form-group">
        <label>닉네임</label>
        <input id="loginNickname" type="text" />
      </div>
      <div class="form-group">
        <label>비밀번호</label>
        <input id="loginPassword" type="password" />
      </div>
      <div class="form-group">
        <label>로그인 유지 기간</label>
        <select id="loginSessionDays">
          <option value="1">1일</option>
          <option value="7" selected>7일</option>
          <option value="30">30일</option>
          <option value="180">180일</option>
          <option value="365">1년</option>
        </select>
      </div>
      <div class="btn-row"><button class="btn-primary" id="loginSubmitBtn">로그인</button></div>
      <div class="form-error" id="loginError"></div>
    `;
  }

  function renderRegisterFormHtml() {
    return `
      <div class="form-group">
        <label>닉네임</label>
        <input id="registerNickname" type="text" />
        <div class="form-hint">공백 불가 · 특수기호는 -, _ 만 가능 · 한글/영문 2~20자</div>
      </div>
      <div class="form-group">
        <label>비밀번호</label>
        <input id="registerPassword" type="password" />
      </div>
      <div class="form-group">
        <label>메모 (선택)</label>
        <textarea id="registerMemo" rows="2" placeholder="관리자에게 남길 메모"></textarea>
      </div>
      <div class="form-hint" style="margin-bottom: 10px;">
        가입 후 설정한 키워드의 글을 디스코드 알림으로 받을 수 있습니다. <br>
        아이디, 비밀번호가 유출되어도 상관없도록 간단하게 설정하세요.
      </div>
      <div class="btn-row"><button class="btn-primary" id="registerSubmitBtn">가입 요청</button></div>
      <div class="form-error" id="registerError"></div>
      <div class="form-success" id="registerSuccess"></div>
    `;
  }

  function setupAuthTabs() {
    const tabs = document.querySelectorAll(".tab-btn");
    const content = document.getElementById("authTabContent");
    if (!content) return;

    function showTab(tab) {
      tabs.forEach((t) =>
        t.classList.toggle("active", t.getAttribute("data-tab") === tab),
      );
      if (tab === "login") {
        content.innerHTML = renderLoginFormHtml();
        document.getElementById("loginSubmitBtn").onclick = doLogin;
      } else {
        content.innerHTML = renderRegisterFormHtml();
        document.getElementById("registerSubmitBtn").onclick = doRegister;
      }
    }

    tabs.forEach((t) => {
      t.onclick = () => showTab(t.getAttribute("data-tab"));
    });
    showTab("login");
  }

  async function doLogin() {
    const nickname = document.getElementById("loginNickname").value.trim();
    const password = document.getElementById("loginPassword").value;
    const sessionDays = Number(
      document.getElementById("loginSessionDays").value,
    );
    const errorEl = document.getElementById("loginError");
    errorEl.textContent = "";

    try {
      const res = await fetch(`${apiPrefix}/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nickname, password, sessionDays }),
      });
      const data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data.error || "로그인에 실패했습니다.";
        return;
      }

      currentUser = data.user;
      await initAfterAuthChange();
      renderSettingsCard();
    } catch (err) {
      errorEl.textContent = "로그인 중 오류가 발생했습니다.";
    }
  }

  async function doRegister() {
    const nickname = document.getElementById("registerNickname").value.trim();
    const password = document.getElementById("registerPassword").value;
    const memo = document.getElementById("registerMemo").value.trim();
    const errorEl = document.getElementById("registerError");
    const successEl = document.getElementById("registerSuccess");
    errorEl.textContent = "";
    successEl.textContent = "";

    try {
      const res = await fetch(`${apiPrefix}/auth/register`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nickname, password, memo }),
      });
      const data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data.error || "가입에 실패했습니다.";
        return;
      }
      successEl.textContent = data.message || "가입 요청이 접수되었습니다.";
    } catch (err) {
      errorEl.textContent = "가입 중 오류가 발생했습니다.";
    }
  }

  function renderApprovedSettingsHtml(profile, keywords, sessions) {
    const el = document.getElementById("settingsContent");
    const siteFilterList = profile.site_filter || Array.from(activeSources);
    const kwFilterList = profile.keyword_filter || [];

    el.innerHTML = `
      <h3>설정 — ${escapeHtml(profile.nickname)}</h3>
      
      <div class="settings-section">
        <h4>Discord 알림 웹훅</h4>
        <div class="form-group">
          <input id="webhookInput" type="text" placeholder="https://discord.com/api/webhooks/..." value="${profile.discord_webhook_url ? escapeHtml(profile.discord_webhook_url) : ""}" />
        </div>
        <div class="btn-row">
          <button class="btn-secondary" id="webhookTestBtn">핫딜 알림 테스트</button>
        </div>
        <div class="form-error" id="webhookMsg"></div>
      </div>

      <div class="settings-section">
        <h4>알림받을 키워드</h4>
        <div class="chip-list" id="notifyKeywordChips"></div>
        <div class="chip-add-row">
          <input id="notifyKeywordInput" type="text" placeholder="새 키워드 입력" />
          <button id="notifyKeywordAddBtn">추가</button>
        </div>
      </div>

      <div class="settings-section">
        <h4>로그인 유지 기간</h4>
        <div class="form-group">
          <select id="sessionDurationSelect">
            <option value="1">1일</option>
            <option value="7">7일</option>
            <option value="30">30일</option>
            <option value="180">180일</option>
            <option value="365">1년</option>
          </select>
        </div>
      </div>

      <div class="settings-section">
        <h4>로그인된 기기</h4>
        <div id="sessionList"></div>
        <div class="btn-row">
          <button class="btn-secondary" id="logoutAllBtn">전체 기기 로그아웃</button>
        </div>
      </div>

      <div class="form-error" id="settingsError"></div>
      <div class="form-success" id="settingsSuccess"></div>
      <div class="btn-row">
        <button class="btn-primary" id="settingsSaveBtn">저장</button>
        <button class="btn-secondary" id="settingsCancelBtn">닫기</button>
        <button class="btn-secondary" id="settingsLogoutBtn">로그아웃</button>
      </div>
    `;

    document.getElementById("sessionDurationSelect").value = String(
      profile.session_duration_days,
    );

    let notifyKeywords = keywords.slice();
    function renderNotifyKeywordChips() {
      const wrap = document.getElementById("notifyKeywordChips");
      wrap.innerHTML =
        notifyKeywords
          .map(
            (k) => `
        <span class="keyword-chip">${escapeHtml(k.keyword)} <button data-id="${k.id}">✕</button></span>
      `,
          )
          .join("") ||
        '<span class="form-hint">등록된 키워드가 없습니다.</span>';
      wrap.querySelectorAll("button").forEach((btn) => {
        btn.onclick = async () => {
          const id = btn.getAttribute("data-id");
          await fetch(`${apiPrefix}/me/keywords/${id}`, { method: "DELETE" });
          notifyKeywords = notifyKeywords.filter((k) => String(k.id) !== id);
          renderNotifyKeywordChips();
        };
      });
    }
    renderNotifyKeywordChips();

    document.getElementById("notifyKeywordAddBtn").onclick = async () => {
      const input = document.getElementById("notifyKeywordInput");
      const value = input.value.trim();
      if (!value) return;
      const res = await fetch(`${apiPrefix}/me/keywords`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ keyword: value }),
      });
      if (res.ok) {
        const listData = await fetch(`${apiPrefix}/me/keywords`).then((r) =>
          r.json(),
        );
        notifyKeywords = listData.keywords;
        renderNotifyKeywordChips();
        input.value = "";
      }
    };

    function renderSessionList(list) {
      const wrap = document.getElementById("sessionList");
      wrap.innerHTML = list
        .map(
          (s) => `
        <div class="session-row">
          <div class="session-info">
            <span>${escapeHtml(s.userAgentSummary || "알 수 없는 기기")}${s.isCurrent ? '<span class="session-current-badge">이 기기</span>' : ""}</span>
            <span class="form-hint">${formatDate(s.createdAt)} 로그인</span>
          </div>
          <button data-id="${s.id}">로그아웃</button>
        </div>
      `,
        )
        .join("");
      wrap.querySelectorAll("button").forEach((btn) => {
        btn.onclick = async () => {
          await fetch(
            `${apiPrefix}/auth/sessions/${btn.getAttribute("data-id")}`,
            { method: "DELETE" },
          );
          const isCurrentDevice = list.find(
            (s) => String(s.id) === btn.getAttribute("data-id"),
          )?.isCurrent;
          if (isCurrentDevice) {
            await onLoggedOut();
            return;
          }
          const refreshed = await fetch(`${apiPrefix}/auth/sessions`).then(
            (r) => r.json(),
          );
          renderSessionList(refreshed.sessions);
        };
      });
    }
    renderSessionList(sessions);

    document.getElementById("logoutAllBtn").onclick = async () => {
      await fetch(`${apiPrefix}/auth/logout-all`, { method: "POST" });
      await onLoggedOut();
    };

    document.getElementById("webhookTestBtn").onclick = async () => {
      const msg = document.getElementById("webhookMsg");
      const url = document.getElementById("webhookInput").value.trim();
      msg.textContent = "전송 중...";
      msg.className = "form-hint";
      const res = await fetch(`${apiPrefix}/me/webhook-test`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ webhookUrl: url }),
      });
      const data = await res.json();
      if (res.ok) {
        msg.textContent = "테스트 메시지를 보냈습니다.";
        msg.className = "form-success";
      } else {
        msg.textContent = data.error || "전송 실패";
        msg.className = "form-error";
      }
    };

    document.getElementById("settingsSaveBtn").onclick = async () => {
      const errorEl = document.getElementById("settingsError");
      const successEl = document.getElementById("settingsSuccess");
      errorEl.textContent = "";
      successEl.textContent = "";

      const res = await fetch(`${apiPrefix}/me`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          discordWebhookUrl:
            document.getElementById("webhookInput").value.trim() || null,
          siteFilter: Array.from(activeSources),
          keywordFilter: keywordFilters,
          sessionDurationDays: Number(
            document.getElementById("sessionDurationSelect").value,
          ),
        }),
      });
      const data = await res.json();
      if (res.ok) {
        successEl.textContent = "저장되었습니다.";
        setTimeout(() => {
          document.getElementById("settingsCard").classList.remove("open");
        }, 500);
      } else {
        errorEl.textContent = data.error || "저장에 실패했습니다.";
      }
    };

    document.getElementById("settingsCancelBtn").onclick = () => {
      document.getElementById("settingsCard").classList.remove("open");
    };

    document.getElementById("settingsLogoutBtn").onclick = doLogout;

    activeSources = new Set(siteFilterList);
    keywordFilters = kwFilterList.slice();
    renderFilterCard();
    renderDealsList();
  }

  async function doLogout() {
    await fetch(`${apiPrefix}/auth/logout`, { method: "POST" });
    await onLoggedOut();
  }

  async function onLoggedOut() {
    currentUser = null;
    currentProfile = null;
    activeSources = new Set(Object.keys(SOURCE_LABELS));
    keywordFilters = [];
    renderFilterCard();
    renderSettingsCard();
    await fetchDealsPage({ reset: true });
  }

  async function initAfterAuthChange() {
    if (currentUser && currentUser.approved) {
      try {
        const profileData = await fetch(`${apiPrefix}/me`).then((r) =>
          r.json(),
        );
        currentProfile = profileData.user;
        activeSources = new Set(
          profileData.user.site_filter || Object.keys(SOURCE_LABELS),
        );
        keywordFilters = profileData.user.keyword_filter || [];
      } catch (e) {
        // failed to fetch profile
      }
    } else {
      activeSources = new Set(Object.keys(SOURCE_LABELS));
      keywordFilters = [];
    }
    renderFilterCard();
    await fetchDealsPage({ reset: true });
  }

  function setupSettingsToggle() {
    const btn = document.getElementById("settingsBtn");
    const card = document.getElementById("settingsCard");
    if (!btn || !card) return;
    btn.onclick = () => {
      card.classList.toggle("open");
      if (card.classList.contains("open")) renderSettingsCard();
    };
  }

  const POLL_INTERVAL_MS = 60_000;
  let pollTimer = null;
  async function pollForNewDeals() {
    if (pagesLoaded > 1) return;
    try {
      await fetchDealsPage({ reset: true });
    } catch (err) {
      console.error("자동 갱신 실패:", err);
    }
  }

  const initDealsPage = async () => {
    // Only init if the page has our elements
    if (!document.getElementById("dealsList")) return;

    setupSettingsToggle();
    setupSearch();
    setupMoreButton();
    setupFilterToggle();

    await loadCurrentUser();
    await initAfterAuthChange();

    if (pollTimer) clearInterval(pollTimer);
    pollTimer = setInterval(pollForNewDeals, POLL_INTERVAL_MS);
  };

  document.addEventListener("astro:page-load", initDealsPage);
</script>

